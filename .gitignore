# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reports
lighthouse-report.json

# theme customizer — merchant-editable content and credentials live here, and
# are environment-specific rather than part of the codebase
/data
!/data/redirects.json
!/data/theme-published.json
!/data/theme-draft.json
# theme customizer — uploaded media
/public/uploads

# scratch scripts
scratch/
